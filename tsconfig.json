{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "types": ["jest", "node"]
  },
  "include": [
    "desktop/src/**/*",
    "__tests__/**/*"
  ],
  "exclude": [
    "node_modules",
    "desktop/dist"
  ]
}
