{
  "name": "rent-ledger",
  "version": "1.0.0",
  "description": "Private, offline rental income, expenses, and property construction management application for macOS",
  "author": "aadiupa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aadiupa/rent-ledger.git"
  },
  "scripts": {
    "dev": "cd desktop && npm run dev",
    "build": "cd desktop && npm run build",
