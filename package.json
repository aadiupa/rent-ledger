    "start": "cd desktop && npm start",
    "test": "jest --config jest.config.cjs --runInBand"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.7.3"
  },
  "private": true
}
